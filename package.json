{
  "name": "livewire-v2",
  "private": true,
  "version": "0.1.0",
  "description": "LiveWire rebuilt: catch, photo and release scoring for kayak fishing tournaments",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project api",
    "test:watch": "vitest --project unit",
    "test:parity": "vitest run --project parity",
    "test:db": "vitest run --project db",
    "db:types": "vitest run --project db tests/db/types.test.ts --update",
    "test:remote": "vitest run --project remote",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:db"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "idb": "8.0.3",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@supabase/postgrest-typegen": "0.3.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
}
