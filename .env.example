# The Supabase project a build talks to. Both values are public by design:
# the publishable key names the project, and the database's own rules decide
# what each phone may do. On Vercel these are project settings (see README).
# Left out, the app runs with no server and says so at the top of each screen.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
